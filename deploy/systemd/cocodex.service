[Unit]
Description=CoCodex gateway and console backend
After=network-online.target
Wants=network-online.target
PartOf=cocodex.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=%h/cocodex
Environment=NODE_ENV=production
EnvironmentFile=-%h/cocodex/.env
ExecStart=%h/cocodex/crates/proxy/target/release/cocodex
# SIGTERM makes the server stop accepting connections and flush settlements.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
