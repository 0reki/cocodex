[Unit]
Description=CoCodex Express Backend
After=network-online.target
Wants=network-online.target
PartOf=cocodex.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=HOME=%h
Environment=PNPM_HOME=%h/.local/share/pnpm
Environment=PATH=%h/.local/share/pnpm:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=%h/cocodex
Environment=NODE_ENV=production
EnvironmentFile=-%h/cocodex/.env
ExecStart=/usr/bin/env pnpm start
ExecStop=/bin/kill -s SIGINT $MAINPID
Restart=always
RestartSec=2
TimeoutStopSec=30
KillSignal=SIGINT
KillMode=control-group
SendSIGKILL=yes
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
