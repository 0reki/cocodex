NODE_ENV=production

HOST=0.0.0.0
PORT=53141
DATABASE_URL=postgresql://postgres:postgres@db:5432/cocodex
COCODEX_CONFIG_PATH=/data/config.json
PORTAL_INVITATION_TTL_SECONDS=604800
# PUBLIC_APP_URL=https://cocodex.example.com
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=5000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
PG_QUERY_TIMEOUT_MS=20000
PG_LOCK_TIMEOUT_MS=5000
PG_SSL_MODE=disable
OPENAI_API_USER_AGENT=node/22.14.0
CODEX_CLIENT_VERSION=0.152.0
# 可选：按 slug 覆盖内置美元价格
# OPENAI_MODEL_PRICING_JSON=[]
BILLING_OVERDRAFT_LIMIT_USD=10
BILLING_INFLIGHT_RESERVE_USD=1
RESPONSE_SETTLEMENT_BATCH_SIZE=200
RESPONSE_SETTLEMENT_FLUSH_INTERVAL_MS=1000
RESPONSE_SETTLEMENT_ID_CACHE_SIZE=10000
RESPONSE_SETTLEMENT_QUEUE_MAX=20000
RESPONSE_SETTLEMENT_RETRY_MAX_MS=5000
