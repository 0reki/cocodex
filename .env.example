HOST=0.0.0.0
PORT=53141
COCODEX_CONFIG_PATH=./data/config.json
# 日志级别，例如 cocodex_proxy=debug,tower_http=info（默认 info）
# RUST_LOG=cocodex=info,cocodex_proxy=info,tower_http=info
# 可选：预先提供数据库地址；留空时在前端 /setup 页面填写
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cocodex
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=5000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
PG_LOCK_TIMEOUT_MS=5000
PG_SSL_MODE=disable
# 可选：完全由环境变量管理的部署可提供以下三项
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_JWT_SECRET=replace-with-a-random-secret
# Codex 客户端 JWT（不设则使用 ADMIN_JWT_SECRET；两者都没有且未完成 Setup 时，网关返回 503 setup_required）
# CODEX_CLIENT_JWT_SECRET=replace-with-a-random-secret
ADMIN_ACCESS_TOKEN_TTL_SECONDS=864000
ADMIN_REFRESH_TOKEN_TTL_SECONDS=2592000
PORTAL_INVITATION_TTL_SECONDS=604800
# production 时刷新 Cookie 带 Secure 标记（需要 HTTPS）
# NODE_ENV=production
# Codex 订阅客户端登录会跳到这个前端地址，例如 http://localhost:5173
# PUBLIC_APP_URL=https://cocodex.example.com
# auto: 后台查询 GitHub 最新稳定版；也可填写版本号以固定版本
CODEX_CLIENT_VERSION=auto
# 可选，只用于 GitHub Release 查询，提高共享出口 IP 下的请求限额
CODEX_GITHUB_TOKEN=
# 对话环境上下文里的时区/日期按此设置，避免泄露用户所在地。
# 不填或填 auto：启动时按网关出口 IP 定位一次，整个生命周期复用。
# 也可固定为 <IANA时区> 或 <IANA时区>|<UTC偏移秒>，例如 Asia/Shanghai|28800
# COCODEX_EGRESS_LOCALE=auto
# 可选：按 slug 覆盖内置美元价格
# OPENAI_MODEL_PRICING_JSON=[]
RESPONSE_SETTLEMENT_BATCH_SIZE=200
RESPONSE_SETTLEMENT_FLUSH_INTERVAL_MS=1000
RESPONSE_SETTLEMENT_ID_CACHE_SIZE=10000
RESPONSE_SETTLEMENT_QUEUE_MAX=20000
RESPONSE_SETTLEMENT_RETRY_MAX_MS=5000
RESPONSE_SETTLEMENT_WAL_PATH=./data/response-settlements.wal
RESPONSE_SETTLEMENT_WAL_COMPACT_AFTER_RECORDS=10000
UPSTREAM_QUOTA_REFRESH_INTERVAL_MS=30000
