E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cocodex
E2E_SOURCE_ACCOUNT_ID=replace-with-chatgpt-account-id
E2E_SOURCE_ID_TOKEN=replace-with-id-token
E2E_SOURCE_ACCESS_TOKEN=replace-with-access-token
E2E_SOURCE_REFRESH_TOKEN=replace-with-refresh-token
# 可选：从同一测试库读取现成账号，设置后四项 Token/Account ID 均可省略
# E2E_SOURCE_FIXTURE_EMAIL=existing-account@example.test
# E2E_SOURCE_EMAIL=e2e@example.test
# E2E_PORT=53142
# E2E_SKIP_IMAGES=false
# E2E_KEEP_SCHEMA=false
